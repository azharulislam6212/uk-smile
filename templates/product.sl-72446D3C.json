    "rich-text-0": {
      "type": "rich-text",
      "blocks": {
        "heading": {
          "type": "heading",
          "settings": {
            "heading": "<p>It cleans quite thoroughly for how little effort it takes. The silicone is soft and comfortable. Definitely more convenient than a regular brush. I bought one for my partner too. <\/p>",
            "heading_size": "h2"
          }
        },
        "text": {
          "type": "text",
          "settings": {
            "text": "<p>- Natasha J.<\/p>"
          }
        }
      },
