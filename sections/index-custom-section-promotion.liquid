<section class="asyncLoad" id="promotion">
  <div class="custom-container">
    <div class="custom-row">
      {% for block in section.blocks %}
        <div class="custom-col custom-col-6">
            {% if  block.settings.bg != blank %}
                <div class="promotion-blk" style="background-image: url('{{  block.settings.bg | img_url:'' }}');">
            {% endif %}
            <div class="content">
              {% if  block.settings.discount1 %}
                {% if block.settings.discount != blank %}
                  <span class="badge" style="background-color:{{ block.settings.color1 }};">{{ block.settings.discount }}</span>
                {% endif %}
              {% endif %}
              {% if  block.settings.heading != blank %}
                <h3 class="heading">{{ block.settings.heading }}</h3>
              {% endif %}
              {% if block.settings.description != blank  %}
                <p>{{ block.settings.description }}</p>
              {% endif %}
              {% if block.settings.btn_txt != blank  %}
                <a href="{{ block.settings.btn_url }}" class="btn">{{ block.settings.btn_txt }}</a>
              {% endif %}
            </div>
          </div>
        </div>
      {% endfor %}
    </div>
  </div>
</section>
{% schema %}
{
  "name": "Promotion",
   "blocks":[
        {
        "type":"Promotions",
        "name":"Add Promotions",
        "settings":
          [
              {
                "type": "image_picker",
                "id": "bg",
                "label": "Background Image"
              },
              {
                "type": "checkbox",
                "id": "discount1",
                "label": "Hide / Show Discount tag"
              },
              {
                "type": "color",
                "id": "color1",
                "label": "Select Color"
              },
              {
                "type": "text",
                "id": "discount",
                "label": "Add Discount"
              },
              {
                "type": "text",
                "id": "heading",
                "label": "Heading"
              },
             {
                "type": "textarea",
                "id": "description",
                "label": "Description"
              },
              {
                "type": "text",
                "id": "btn_txt",
                "label": "Button Text"
               },
              {
                "type": "url",
                "id": "btn_url",
                "label": "Button Link"
               }       
          ]
        }
    ],
    "presets": [
      {
      "name": "Promotion",
      "category": "Custom Sections"
      }
    ]
}
{% endschema %}

{% stylesheet %}
{% endstylesheet %}

