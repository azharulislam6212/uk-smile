    "collapsible-content": {
      "type": "collapsible-content",
      "blocks": {
        "collapsible-row-3": {
          "type": "collapsible_row",
          "settings": {
            "heading": "Features:",
            "icon": "lightning_bolt",
            "row_content": "<p>✓ Compatible with the Smile Therapy Sonic 5-in-1 Electric Toothbrush<br\/><br\/>✓ Soft W-cut bristles help reach between teeth and hard-to-clean areas<br\/><br\/>✓ Designed to work with all 5 brushing modes<br\/><br\/>✓ Gentle on teeth and gums for everyday brushing comfort<br\/><br\/>✓ Helps remove daily plaque and buildup<br\/><br\/>✓ Easy to rinse, quick to replace, and simple to maintain<br\/><br\/>✓ Keeps your brushing routine fresh, hygienic, and consistent<\/p>",
            "page": ""
          }
        },
        "collapsible-row-1": {
          "type": "collapsible_row",
          "settings": {
            "heading": "When should I replace the brush head?",
            "icon": "question_mark",
            "row_content": "<p>For best results, we recommend changing your brush head every <strong>2 months<\/strong>.<\/p><p>A fresh brush head helps maintain cleaning performance, keeps the bristles effective, and gives you a more hygienic brushing experience every day.<\/p>",
            "page": ""
          }
        },
        "2eef6090-250f-48ad-a4ec-4aacca83c975": {
          "type": "collapsible_row",
          "settings": {
            "heading": "Care Tips",
            "icon": "clipboard",
            "row_content": "<p> ✓ Rinse your brush head thoroughly after every use<br\/> ✓ Store upright in a clean, dry place<br\/> ✓ Allow the bristles to air dry naturally<br\/> ✓ Replace regularly for the best brushing performance<br\/>✗ Do not share brush heads between users<\/p>",
            "page": ""
          }
        },
        "3442c9b0-dbb6-4dd7-b615-9313ba45f523": {
          "type": "collapsible_row",
          "settings": {
            "heading": " What’s in the box?",
            "icon": "box",
            "row_content": "<ul><li>4x Sonic 5-in-1 Electric Toothbrush Replacement Heads<\/li><\/ul><p><em>(Toothbrush handle sold separately)<\/em><\/p>",
            "page": ""
          }
        },
        "4629f7ef-2bd9-46e7-a3d7-291adcdb936a": {
          "type": "collapsible_row",
          "disabled": true,
          "settings": {
            "heading": "Long-Lasting Battery",
            "icon": "check_mark",
            "row_content": "<p>Up to 3 weeks use per charge<\/p><p>Quick, convenient USB-C charging<\/p>",
            "page": ""
          }
        },
        "dc156c5a-46c9-43e5-acbd-475340353fc0": {
          "type": "collapsible_row",
          "disabled": true,
          "settings": {
            "heading": "How to use the electric dental cleaning kit?",
            "icon": "washing",
            "row_content": "<p>1. Select your desired attachment based on your oral needs.<\/p><p>2. Turn on the device and alter between modes based on your cleaning needs.<\/p><p>3. Alter between heads if necessary.<\/p><p>4. Clean the device and the tip after use. <\/p>",
            "page": ""
          }
        },
        "b156cbed-7093-4197-84e3-0ced68818bea": {
          "type": "collapsible_row",
          "disabled": true,
          "settings": {
