    "collapsible-content": {
      "type": "collapsible-content",
      "blocks": {
        "collapsible-row-3": {
          "type": "collapsible_row",
          "settings": {
            "heading": "Features:",
            "icon": "lightning_bolt",
            "row_content": "<p>✓ Extra strong textured floss <\/p><p>✓ Fluoride coating to help prevent tooth decay <\/p><p>✓ Mint flavoured to eradicate any odd string flavours.<\/p><p>✓ Flexible bristle pick that brushes deep between your teeth <br\/><\/p><p>✓ Pick also gently massages gums<\/p><p>✓ Curved, easy reach design allows you to access all areas of your mouth <br\/><\/p><p>✓ Scaling tool cleans the surface of your teeth for added plaque and stain removal<br\/><\/p><p>✓ Antibacterial handle & floss for a more hygienic clean<br\/><\/p><p>✓ Vegan Friendly<\/p>",
            "page": ""
          }
        },
        "collapsible-row-1": {
          "type": "collapsible_row",
          "settings": {
            "heading": "What's in the box?",
            "icon": "box",
            "row_content": "<p>Each package contains:<\/p><p>100x  Mint Dental Floss Picks<\/p><p>1x Manual<\/p>",
            "page": ""
          }
        },
        "dc156c5a-46c9-43e5-acbd-475340353fc0": {
          "type": "collapsible_row",
          "disabled": true,
          "settings": {
            "heading": "How to use the electric dental cleaning kit?",
            "icon": "washing",
            "row_content": "<p>1. Select your desired attachment based on your oral needs.<\/p><p>2. Turn on the device and alter between modes based on your cleaning needs.<\/p><p>3. Alter between heads if necessary.<\/p><p>4. Clean the device and the tip after use. <\/p>",
            "page": ""
          }
        },
        "2eef6090-250f-48ad-a4ec-4aacca83c975": {
          "type": "collapsible_row",
          "settings": {
            "heading": "Cautions",
            "icon": "clipboard",
            "row_content": "<p>✘ Do not force into tight spaces between teeth. <\/p><p>✔ Children require adult supervision.<\/p><p>✔ Please make sure to wash your mouth with warm water after use.<\/p>",
            "page": ""
          }
        },
        "collapsible-row-0": {
          "type": "collapsible_row",
          "disabled": true,
          "settings": {
            "heading": "Cons of not using an Ultra Sonic Tooth Cleaner",
            "icon": "star",
            "row_content": "<p>Bad dental hygiene can be devastating on teeth and gums. Not only can it be expensive, but it can also lead to bad breath, gum disease, receding gums, dental decay, and even tooth loss.<\/p><p>This product may also be reffered to as one of the following:<\/p><p><\/p><p><em>Calculus remover, Dental irrigator, Dental scaler, Oral irrigator, Plaque remover, Tartar removal tool, Tartar remover, Tooth cleaner, Tooth stain remover, Ultrasonic dental cleaner, Ultrasonic scaler, Ultrasonic tooth cleaner.<\/em><\/p><p><\/p>",
            "page": ""
          }
        },
        "3442c9b0-dbb6-4dd7-b615-9313ba45f523": {
          "type": "collapsible_row",
          "settings": {
            "heading": "Instructions & Tips",
            "icon": "question_mark",
            "row_content": "<p>Pick Instructions: <\/p><p>1. Place pick between teeth and gently press against the gum. <\/p><p>2.Use an in and out motion to remove food particles and stimulate gums. <\/p><p>3. Rinse as necessary.<\/p>",
            "page": ""
          }
        }
      },
