    "collapsible-content": {
      "type": "collapsible-content",
      "blocks": {
        "collapsible-row-3": {
          "type": "collapsible_row",
          "settings": {
            "heading": "List of ingredients",
            "icon": "leaf",
            "row_content": "<p>PVP, Phthalimidoperoxycaproic acid, Glycerin, Aqua, Ethylcellulose, Xylitol, Xanthan gum, Hydroxyapatite, Sodium Citrate, Menthol.<br\/><br\/><strong>Allergens: <\/strong>Limonene, Linalool<\/p>",
            "page": ""
          }
        },
        "collapsible-row-1": {
          "type": "collapsible_row",
          "settings": {
            "heading": "Instructions",
            "icon": "question_mark",
            "row_content": "<p><strong>1. <\/strong>Ensure your teeth are dry before using.<br\/><br\/><strong>2.<\/strong> Peel off the long strip and apply sticky side to the top half of your teeth.<br\/><br\/><strong>3.<\/strong> Press strip down firmly and folder over the back of your teeth to secure.<br\/><br\/><strong>4.<\/strong> Repeat the same for the bottom half with the shorter strip.<br\/><br\/><strong>5. <\/strong>Leave on your teeth for 30 minutes for maximum whitening treatment.<br\/><br\/><strong>6.<\/strong> Remove strips and rinse mouth with water.<\/p>",
            "page": ""
          }
        },
        "collapsible-row-0": {
          "type": "collapsible_row",
          "settings": {
            "heading": "Warnings",
            "icon": "lightning_bolt",
            "row_content": "<p>• For external use only. <br\/>• Do not use on broken or sensitive gums. <br\/>• Do not use the strips if you have mouth ulcers, gum injury, or after oral operations. <br\/>• Avoid contact with eyes. If contact occurs, rinse with water immediately. <br\/>• Not for use by children under 14 years. <br\/>• Not recommended for pregnant women. <br\/>• Do not swallow strips. <br\/>• Do not smoke, vape, drink or sleep whilst using the strips. <br\/>• Keep out of reach of children. <br\/>• Use as directed and do not repeat treatment more frequently than once in a month.<\/p>",
            "page": ""
          }
        },
        "dc156c5a-46c9-43e5-acbd-475340353fc0": {
          "type": "collapsible_row",
          "settings": {
            "heading": "How do teeth whitening strips whiten?",
            "icon": "eye",
            "row_content": "<p>When applied to your teeth, each strip firmly adheres to the tooth surface and releases the active ingredients of the whitening formula into the tooth’s structure to help lift surface stains while remaining gentle on teeth<\/p>",
            "page": ""
          }
        },
        "1efe8090-8cc3-4d87-874c-e2af1cea652a": {
          "type": "collapsible_row",
          "settings": {
            "heading": "Whats in the box?",
            "icon": "box",
            "row_content": "<p>Each order of teeth whitening strips consists of 14 treatments.<br\/><\/p><ul><li><strong>14x<\/strong> individually packed strips for individual use.<\/li><li><strong>1x<\/strong> Teeth shade chart (to monitor and track your progress)<\/li><\/ul>",
            "page": ""
          }
        },
        "collapsible_row_wPUNyh": {
          "type": "collapsible_row",
          "disabled": true,
          "settings": {
            "heading": "Can the Teeth Whitening Strips be used on composite bonding, veneers or fillings?",
            "icon": "question_mark",
            "row_content": "<p>Yes, it can be used on composite bonding, veneers, and fillings. While it will not whiten these materials, it effectively helps to remove daily stains.<\/p>",
            "page": ""
          }
        }
      },
