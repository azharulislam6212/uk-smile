    "rich-text-0": {
      "type": "rich-text",
      "blocks": {
        "heading": {
          "type": "heading",
          "settings": {
            "heading": "<p>\"GENUINELY WISH I FOUND THIS SOONER, MY MOUTH FEELS BRAND NEW EVERY DAY - NEVER THOUGHT I'D ENJOY BRUSHING THIS MUCH + LOVE THE DESIGN 10\/10\"<\/p>",
            "heading_size": "h2"
          }
        },
