    "rich-text-0": {
      "type": "rich-text",
      "blocks": {
        "heading": {
          "type": "heading",
          "settings": {
            "heading": "<p>\"I HAVE HAD MANY ELECTRIC TOOTHBRUSHES BUT THIS IS ONE THAT'S LASTED ME OVER 1 YEAR, LOVE THIS TOOTHBRUSH\"<\/p>",
            "heading_size": "h2"
          }
        },
        "text": {
          "type": "text",
          "settings": {
            "text": "<p>- Tom. D<\/p>"
          }
        }
      },
