        "heading": {
          "type": "heading",
          "settings": {
            "heading": "<p>\"WORKS LIKE A CHARM, SEEN RESULTS ALMOST INSTANTLY. MUCH BETTER THAN THOSE COMPANIES THAT CHARGE EXORBITANT FEES FOR TEETH WHITENING\"<\/p>",
