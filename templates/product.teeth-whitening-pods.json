        "collapsible-row-3": {
          "type": "collapsible_row",
          "settings": {
            "heading": "Ingredients - Each Pod Contains:",
            "icon": "lightning_bolt",
            "row_content": "<p>Aqua, PVP, Phthalimidoperoxycaproic Acid, Glycerin, Xanthan Gum, Potassium Citrate, Mentha Piperita Oil, CI 77891, Mica, Cellulose Gum, Hydroxyapatite & Sodium Saccharin<\/p><p><strong>Allergens: Limonene, Linalool.<\/strong><\/p>",
            "page": ""
          }
        },
        "collapsible-row-1": {
          "type": "collapsible_row",
          "settings": {
            "heading": "What's in the box?",
            "icon": "box",
            "row_content": "<p>Each package includes:<\/p><ul><li>6x Teeth Whitening Refill Gels (12 Treatments)<\/li><\/ul>",
            "page": ""
          }
        },
        "dc156c5a-46c9-43e5-acbd-475340353fc0": {
          "type": "collapsible_row",
          "disabled": true,
          "settings": {
            "heading": "How to use the electric dental cleaning kit?",
            "icon": "washing",
            "row_content": "<p>1. Select your desired attachment based on your oral needs.<\/p><p>2. Turn on the device and alter between modes based on your cleaning needs.<\/p><p>3. Alter between heads if necessary.<\/p><p>4. Clean the device and the tip after use. <\/p>",
            "page": ""
          }
        },
        "2eef6090-250f-48ad-a4ec-4aacca83c975": {
          "type": "collapsible_row",
          "settings": {
            "heading": "Cautions",
            "icon": "clipboard",
            "row_content": "<p>1. Not to be used while pregnant or breastfeeding.<br\/><br\/>2. Not recommended for children under the age of 12.<br\/><br\/>3. Only buy certified Teeth Whitening Kits<br\/><br\/>4. Please make sure to wash your mouth with warm water after use.<\/p>",
            "page": ""
          }
        },
        "collapsible-row-0": {
          "type": "collapsible_row",
          "disabled": true,
          "settings": {
            "heading": "Can the Refills be used on composite bonding, veneers or fillings?",
            "icon": "question_mark",
            "row_content": "<p>Yes, the Teeth Whitening Refills are suitable for use on composite bonding, veneers, and fillings. While the kit is designed to safely whiten your natural teeth, it also helps to remove surface stains on dental restorations. The formula is gentle on all dental materials, ensuring that your composite bonding, veneers, and fillings remain intact while your smile is brightened.<\/p>",
            "page": ""
          }
        }
