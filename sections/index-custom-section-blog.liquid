<!-- Blog Posts -->
<section class="asyncLoad" id="blog-posts">
  <div class="custom-container">
    <div class="title">
      <div class="text">
        <h2 class="heading">{{ section.settings.heading }}</h2>
        <p>{{ section.settings.description }}</p>
      </div>
      <div class="btn-blk" style="margin:11px;">
      {% if section.settings.btn-txt != blank  %}
        <a href="{{ section.settings.btn-url }}" class="btn">{{ section.settings.btn-txt }}</a>
      {% endif %}
      </div>
    </div>
    <div id="slick-blogs">
      {% for block in section.blocks %}
        <div class="items">
        <a href="{% if block.settings.blog_url != blank  %}{{ block.settings.blog_url }}{% else %}javascript:void(0);{% endif %}" class="post-action">
          <div class="post-card">
            {% if block.settings.blog_img != blank %}
              <img data-src="{{ block.settings.blog_img | img_url:'' }}" class="lazyload">
            {% endif %}
            <div class="content">
              <div class="time-date">{{ block.settings.blog_date }}</div>
              <h4 class="heading">{{ block.settings.blog_heading }}</h4>
            </div>
          </div>
        </a>
      </div>
      {% endfor %}
    </div>
  </div>
</section>
{% schema %}
{
  "name": "Lastest Blog",
    "settings": [
        {
          "type": "text",
          "id": "heading",
          "label": "Heading"
        },
        {
          "type": "textarea",
          "id": "description",
          "label": "Description"
        },
        {
          "type": "text",
          "id": "btn-txt",
          "label": "Button Text"
        },
        {
          "type": "url",
          "id": "btn-url",
          "label": "Button Link"
        }
    ],
   "blocks":[
        {
        "type":"Blogs",
        "name":"Add Blogs",
        "settings":
          [
            {
              "type": "image_picker",
              "id": "blog_img",
              "label": "Add Blog Image"
            },
            {
              "type": "text",
              "id": "blog_date",
              "label": "Add Blog Publish Date"
            },
            {
              "type": "text",
              "id": "blog_heading",
              "label": "Add Blog Title"
            },
            {
              "type": "url",
              "id": "blog_url",
              "label": "Link"
            } 
          ]
        }
    ],
    "presets": [
      {
      "name": "Lastest Blog",
      "category": "Custom Sections"
      }
    ]
}
{% endschema %}

{% stylesheet %}
{% endstylesheet %}

