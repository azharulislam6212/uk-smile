  <style>
    {% for block in section.blocks %}
    .content-holder_img{{ forloop.index }}{
      background-image: url('{{ block.settings.bg | img_url:'' }}');
      }
    @media screen and (max-width:767px){
      .content-holder_img{{ forloop.index }}{
      background-image: url('{{ block.settings.bg_mobile | img_url:'' }}');
    }
    }
    {% endfor %}
  </style>
  <div id="img-with-text">
    <div class="custom-container">
      {% for block in section.blocks %}
        {% if block.settings.bg != blank %}
          <div class="content-holder content-holder_img{{ forloop.index }}" style="">
        {% endif %}
          <div class="content">
            {% if block.settings.heading != blank %}
              <h1 class="heading">{{ block.settings.heading }}</h1>
            {% endif %}
            {% if block.settings.description != blank %}
              <p style="color:{{ block.settings.color_description }};">{{ block.settings.description }}</p>
            {% endif %}
            {% if block.settings.btn_txt != blank %}
              <a href="{{ block.settings.btn_url }}" class="btn btn_unset">{{ block.settings.btn_txt }}</a>
            {% endif %}
          </div>
        </div>
      {% endfor %}
    </div>
  </div>
{% schema %}
{
  "name": "Image With Text",
   "blocks":[
        {
        "type":"Image-With-Text",
        "name":"Image With Text",
        "settings":
          [
             {
                "type": "image_picker",
                "id": "bg",
                "label": "Select Background Image"
              },
              {
                "type": "image_picker",
                "id": "bg_mobile",
                "label": "Select Background Image Mobile"
              },
              {
                  "type": "text",
                  "id": "heading",
                  "label": "Heading"
              },
              {
                  "type": "textarea",
                  "id": "description",
                  "label": "Description"
              },
              {
                  "type": "color",
                  "id": "color_description",
                  "label": "Select Color [Description]"
              },
              {
                "type": "text",
                "id": "btn_txt",
                "label": "Button Text"
              },
              {
                "type": "url",
                "id": "btn_url",
                "label": "Button Link"
              }      
          ]
        }
    ],
    "presets": [
      {
      "name": "Image With Text",
      "category": "Custom Sections"
      }
    ]
}
{% endschema %}

{% stylesheet %}
{% endstylesheet %}

