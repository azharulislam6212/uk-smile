      "type": "rich-text",
      "blocks": {
        "heading": {
          "type": "heading",
          "settings": {
            "heading": "<p>\"BEST TOOTHPASTE EVER! MY TEETH FEEL AMAZING ALL DAY, AND I WAKE UP TO FRESH BREATH AND A CLEAN MOUTH, IT'S CRAZY GOOD\" <\/p>",
            "heading_size": "h2"
          }
        },
        "text": {
          "type": "text",
          "settings": {
            "text": "<p>- Sara. T<\/p>"
          }
        }
      },
