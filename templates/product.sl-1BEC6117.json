    "rich-text-0": {
      "type": "rich-text",
      "blocks": {
        "heading": {
          "type": "heading",
          "settings": {
            "heading": "<p>\"THESE STRIPS ARE SO EASY AND GREAT TO USE, WORKS LIKE A CHARM EVERYTIME - HIGHLY RECOMMEND THESE TO EVERYONE\"<\/p>",
