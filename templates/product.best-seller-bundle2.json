    "rich-text-0": {
      "type": "rich-text",
      "blocks": {
        "heading": {
          "type": "heading",
          "settings": {
            "heading": "<p>Wasn’t expecting such a big difference, but using all three together genuinely leaves my teeth feeling cleaner than after a normal brushing routine. My mouth feels noticeably fresher within just a few days.<\/p>",
            "heading_size": "h2"
          }
        },
        "text": {
          "type": "text",
          "settings": {
            "text": "<p>- Tom. D<\/p>"
          }
        }
      },
      "block_order": [
        "heading",
