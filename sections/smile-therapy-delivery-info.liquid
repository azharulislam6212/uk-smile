{{ 'section-smile-therapy-delivery.css' | asset_url | stylesheet_tag }}

{%- liquid
  assign section_id = section.id
  assign default_code = ''
-%}

<div
  class="st-delivery-page st-delivery-page--{{ section_id }}"
  data-section-id="{{ section_id }}"
  style="
    --st-text-color: {{ section.settings.text_color }};
    --st-bg-color: {{ section.settings.background_color }};
    --st-table-header-bg: {{ section.settings.table_header_bg }};
    --st-border-color: {{ section.settings.border_color }};
    --st-note-bg: {{ section.settings.note_bg }};
  "
>
  {%- if section.settings.heading != blank -%}
    <h1 class="st-delivery-page__heading">{{ section.settings.heading }}</h1>
  {%- endif -%}

  {%- if section.settings.intro != blank -%}
    <div class="st-intro">{{ section.settings.intro }}</div>
  {%- endif -%}

  {%- if section.blocks.size > 0 -%}
    <div class="st-picker">
      <label for="st-country-{{ section_id }}">{{ section.settings.picker_label | default: 'Delivery country' }}</label>
      <select id="st-country-{{ section_id }}" class="st-country-select">
        {%- for block in section.blocks -%}
          {%- assign code = block.settings.country_code | strip -%}
          {%- if forloop.first -%}
            {%- assign default_code = code -%}
          {%- endif -%}
          <option value="{{ code }}" {% if forloop.first %}selected{% endif %} {{ block.shopify_attributes }}>
            {{ block.settings.country_name }}
          </option>
        {%- endfor -%}
      </select>
    </div>

    <div id="st-result-{{ section_id }}" class="st-result" aria-live="polite">
      {%- for block in section.blocks -%}
        {%- if forloop.first -%}
          {%- assign active_block = block -%}
          <h2 class="st-result__heading">{{ block.settings.country_name }}</h2>
          <div class="st-wrap">
            <table>
              <thead>
                <tr>
                  <th>Shipping option</th>
                  <th>Rate</th>
                  <th>Estimated delivery</th>
                  {%- if block.settings.layout == 'uk' -%}
                    <th>Courier</th>
                  {%- else -%}
                    <th>Sent with</th>
                    <th>Delivered locally by</th>
                  {%- endif -%}
                </tr>
              </thead>
              <tbody>
                {%- for i in (1..4) -%}
                  {%- case i -%}
                    {%- when 1 -%}
                      {%- assign service = block.settings.method_1_service -%}
                      {%- assign rate = block.settings.method_1_rate -%}
                      {%- assign eta = block.settings.method_1_eta -%}
                      {%- assign sent_with = block.settings.method_1_sent_with -%}
                      {%- assign local_partner = block.settings.method_1_local_partner -%}
                    {%- when 2 -%}
                      {%- assign service = block.settings.method_2_service -%}
                      {%- assign rate = block.settings.method_2_rate -%}
                      {%- assign eta = block.settings.method_2_eta -%}
                      {%- assign sent_with = block.settings.method_2_sent_with -%}
                      {%- assign local_partner = block.settings.method_2_local_partner -%}
                    {%- when 3 -%}
                      {%- assign service = block.settings.method_3_service -%}
                      {%- assign rate = block.settings.method_3_rate -%}
                      {%- assign eta = block.settings.method_3_eta -%}
                      {%- assign sent_with = block.settings.method_3_sent_with -%}
                      {%- assign local_partner = block.settings.method_3_local_partner -%}
                    {%- when 4 -%}
                      {%- assign service = block.settings.method_4_service -%}
                      {%- assign rate = block.settings.method_4_rate -%}
                      {%- assign eta = block.settings.method_4_eta -%}
                      {%- assign sent_with = block.settings.method_4_sent_with -%}
                      {%- assign local_partner = block.settings.method_4_local_partner -%}
                  {%- endcase -%}
                  {%- if service != blank -%}
                    <tr>
                      <td>{{ service }}</td>
                      <td>{{ rate }}</td>
                      <td>{{ eta }}</td>
                      <td>{{ sent_with }}</td>
                      {%- if block.settings.layout != 'uk' -%}
                        <td>{{ local_partner }}</td>
                      {%- endif -%}
                    </tr>
                  {%- endif -%}
                {%- endfor -%}
              </tbody>
            </table>
          </div>
        {%- endif -%}
      {%- endfor -%}
    </div>
  {%- endif -%}

  {%- if section.settings.note_heading != blank or section.settings.note_text != blank -%}
    <div class="st-note">
      {%- if section.settings.note_heading != blank -%}
        <strong>{{ section.settings.note_heading }}</strong><br>
      {%- endif -%}
      {{ section.settings.note_text }}
    </div>
  {%- endif -%}
</div>

{%- comment -%} Build the full country dataset as JSON so the dropdown can swap content client-side, exactly like the original page. {%- endcomment -%}
<script id="st-data-{{ section_id }}" type="application/json">
{
  {%- for block in section.blocks -%}
    {%- assign code = block.settings.country_code | strip -%}
    "{{ code | escape }}": {
      "country": {{ block.settings.country_name | json }},
      "layout": {{ block.settings.layout | json }},
      "methods": [
        {%- assign first_method = true -%}
        {%- for i in (1..4) -%}
          {%- case i -%}
            {%- when 1 -%}
              {%- assign service = block.settings.method_1_service -%}
              {%- assign rate = block.settings.method_1_rate -%}
              {%- assign eta = block.settings.method_1_eta -%}
              {%- assign sent_with = block.settings.method_1_sent_with -%}
              {%- assign local_partner = block.settings.method_1_local_partner -%}
            {%- when 2 -%}
              {%- assign service = block.settings.method_2_service -%}
              {%- assign rate = block.settings.method_2_rate -%}
              {%- assign eta = block.settings.method_2_eta -%}
              {%- assign sent_with = block.settings.method_2_sent_with -%}
              {%- assign local_partner = block.settings.method_2_local_partner -%}
            {%- when 3 -%}
              {%- assign service = block.settings.method_3_service -%}
              {%- assign rate = block.settings.method_3_rate -%}
              {%- assign eta = block.settings.method_3_eta -%}
              {%- assign sent_with = block.settings.method_3_sent_with -%}
              {%- assign local_partner = block.settings.method_3_local_partner -%}
            {%- when 4 -%}
              {%- assign service = block.settings.method_4_service -%}
              {%- assign rate = block.settings.method_4_rate -%}
              {%- assign eta = block.settings.method_4_eta -%}
              {%- assign sent_with = block.settings.method_4_sent_with -%}
              {%- assign local_partner = block.settings.method_4_local_partner -%}
          {%- endcase -%}
          {%- if service != blank -%}
            {%- unless first_method -%},{%- endunless -%}
            {%- assign first_method = false -%}
            {
              "service": {{ service | json }},
              "rate": {{ rate | json }},
              "eta": {{ eta | json }},
              "sent_with": {{ sent_with | json }},
              "local_partner": {{ local_partner | json }}
            }
          {%- endif -%}
        {%- endfor -%}
      ]
    }{% unless forloop.last %},{% endunless %}
  {%- endfor -%}
}
</script>

<script>
(function(){
  var sectionId = {{ section_id | json }};
  var dataEl = document.getElementById('st-data-' + sectionId);
  var sel = document.getElementById('st-country-' + sectionId);
  var out = document.getElementById('st-result-' + sectionId);
  if(!dataEl || !sel || !out) return;

  var data = {};
  try { data = JSON.parse(dataEl.textContent); } catch(e) { data = {}; }

  function esc(v){
    return String(v || '')
      .replace(/&/g,'&amp;')
      .replace(/</g,'&lt;')
      .replace(/>/g,'&gt;')
      .replace(/"/g,'&quot;')
      .replace(/'/g,'&#039;');
  }

  function render(code){
    var item = data[code];
    if(!item) return;

    if(item.layout === 'uk'){
      var ukRows = item.methods.map(function(v){
        return '<tr>' +
          '<td>' + esc(v.service) + '</td>' +
          '<td>' + esc(v.rate) + '</td>' +
          '<td>' + esc(v.eta) + '</td>' +
          '<td>' + esc(v.sent_with) + '</td>' +
        '</tr>';
      }).join('');

      out.innerHTML =
        '<h2 class="st-result__heading">' + esc(item.country) + '</h2>' +
        '<div class="st-wrap"><table>' +
        '<thead><tr><th>Shipping option</th><th>Rate</th><th>Estimated delivery</th><th>Courier</th></tr></thead>' +
        '<tbody>' + ukRows + '</tbody></table></div>';
      return;
    }

    var rows = item.methods.map(function(v){
      return '<tr>' +
        '<td>' + esc(v.service) + '</td>' +
        '<td>' + esc(v.rate) + '</td>' +
        '<td>' + esc(v.eta) + '</td>' +
        '<td>' + esc(v.sent_with) + '</td>' +
        '<td>' + esc(v.local_partner) + '</td>' +
      '</tr>';
    }).join('');

    out.innerHTML =
      '<h2 class="st-result__heading">' + esc(item.country) + '</h2>' +
      '<div class="st-wrap"><table>' +
      '<thead><tr><th>Shipping option</th><th>Rate</th><th>Estimated delivery</th><th>Sent with</th><th>Delivered locally by</th></tr></thead>' +
      '<tbody>' + rows + '</tbody></table></div>';
  }

  sel.addEventListener('change', function(){ render(this.value); });

  {%- if request.design_mode -%}
  document.addEventListener('shopify:section:load', function(evt){
    if(evt.target.querySelector('#st-country-' + sectionId)){
      render(sel.value);
    }
  });
  {%- endif -%}
})();
</script>

