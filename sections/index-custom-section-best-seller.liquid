<style>
  .seller-blk_img{
    background-image: url('{{ section.settings.bg-desktop | img_url:'' }}');
  }
@media screen and (max-width:767px){
  .seller-blk_img{
    background-image: url('{{ section.settings.bg-mobile | img_url:'' }}');
  }
}
</style>
<!-- Best Seller -->
<section class="asyncLoad" id="best-seller">
  <div class="custom-container">
    {% if section.settings.bg-desktop != blank %}
        <div class="seller-blk seller-blk_img" data-aos="fade-down" data-aos-duration="1000" style="">  
    {% endif%} 
     <div class="content">
        {% if section.settings.tag1 %}
          {% if section.settings.tag != blank %}
            <span class="badge" style="background-color:{{ section.settings.color1 }};">{{ section.settings.tag }}</span>
          {% endif %}
        {% endif %}
      <h1 class="heading">{{ section.settings.heading }}</h1>
      <p>{{ section.settings.description }}</p>
       {% if section.settings.btn_txt != blank  %}
         <a href="{{ section.settings.product.url }}" class="btn" style="background-color:{{ section.settings.btn-color }}">{{section.settings.btn_txt}}</a>
       {% endif %}  
         {% if section.settings.sale_tag1 %}
            <div class="sale-tag scale-2"><img src="{{ section.settings.sale_tag | img_url:'' }}"></div>
         {% endif %}
      </div>
   </div>
  </div>
</section>
{% schema %}
{
  "name": "Best Seller-1",
    "settings": [
        {
          "type": "image_picker",
          "id": "bg-desktop",
          "label": "Select Background-Image[Desktop]"
        },
        {
          "type": "image_picker",
          "id": "bg-mobile",
          "label": "Select Background-Image[Mobile]"
        },
        {
          "type": "checkbox",
          "id": "tag1",
          "label": "Show/Hide Tag",
           "default": true
         },
         {
            "type": "color",
            "id": "color1",
            "label": "Select Color"
         },
         {
          "type": "text",
          "id": "tag",
          "label": "Add Tag Text"
         },
         {
          "type": "text",
          "id": "heading",
          "label": "Heading"
         },
         {
          "type": "textarea",
          "id": "description",
          "label": "Description"
         },
         {
          "type": "checkbox",
          "id": "sale_tag1",
          "label": "Show/Hide Sale Tag"
         },
         {
          "type": "image_picker",
          "id": "sale_tag",
          "label": "Add Sale Icon"
         },
         {
          "type": "color",
          "id": "btn-color",
          "label": "Button Color"
         },
         {
          "type": "text",
          "id": "btn_txt",
          "label": "Button Text"
         },
         {
          "type": "product",
          "id": "product",
          "label": "Select Product[for price]"
         }
    ],
    "presets": [
      {
      "name": "Best Seller-1",
      "category": "Custom Sections"
      }
    ]
}
{% endschema %}

{% stylesheet %}
{% endstylesheet %}

