    "collapsible-content": {
      "type": "collapsible-content",
      "blocks": {
        "collapsible-row-3": {
          "type": "collapsible_row",
          "settings": {
            "heading": "Features",
            "icon": "lightning_bolt",
            "row_content": "<p>✓ 5 brushing modes: Clean, White, Soft, Polish and Massage.<\/p><p>✓ 8,000+ brush strokes per minute for a thorough clean.<\/p><p>✓ Smart timer with 2-minute auto shutoff and 30s reminders.<\/p><p>✓ 3D cleaning action reaches every tooth surface.<\/p><p>✓ Dense, soft bristles designed for gentle yet effective cleaning<\/p><p>✓ Battery lasts up to 21 days per full charge.<\/p><p>✓ Fast USB Type-C charging in under 4 hours.<\/p><p>✓ Replaceable brush heads keep hygiene consistent.<\/p><p>✓ IPX7 waterproof and safe to use in the shower.<\/p><p>✓ Sleek, lightweight and easy to travel with.<\/p><p>✓ Developed with expert input for trusted daily care.<br\/><br\/><\/p>",
            "page": ""
          }
        },
        "dc156c5a-46c9-43e5-acbd-475340353fc0": {
          "type": "collapsible_row",
          "settings": {
            "heading": "How to use?",
            "icon": "question_mark",
            "row_content": "<p><strong>1. Prep: <\/strong>Wet the bristles and add toothpaste.<\/p><p><strong>2. Power On: <\/strong>Turn on and choose your brushing mode.<\/p><p><strong>3. Brush Smart: <\/strong>Brush gently. It pulses every 30 seconds to guide you.<\/p><p><strong>4. Auto Stop: <\/strong>Shuts off automatically after 2 minutes.<\/p><p><strong>5. Clean Up: <\/strong>Rinse the head and let it air dry.<\/p>",
            "page": ""
          }
        },
        "collapsible-row-0": {
          "type": "collapsible_row",
          "settings": {
            "heading": "Why choose the 5 in 1?",
            "icon": "star",
            "row_content": "<p>✓ Targets visible buildup in hard-to-reach spots with smart oscillation<br\/><br\/>✓ Feels natural and comfy in your hand for easy brushing every time.<br\/><br\/>✓ Leaves your mouth feeling fresh and gums gently cared for.<br\/><br\/>✓ Five modes: Clean, White, Soft, Polish, Massage.<br\/><br\/>✓ Reliable battery power that keeps your brush ready to go.<\/p>",
            "page": ""
          }
        },
        "collapsible-row-1": {
          "type": "collapsible_row",
          "settings": {
            "heading": "What's in the box?",
            "icon": "box",
            "row_content": "<ul><li>1x Electric Toothbrush<\/li><li>3x Brush Heads<\/li><li>1x Charging Cable (Type-C)<\/li><li>1x User Manual<\/li><\/ul>",
            "page": ""
          }
        },
        "2eef6090-250f-48ad-a4ec-4aacca83c975": {
          "type": "collapsible_row",
          "disabled": true,
          "settings": {
            "heading": "Cautions",
            "icon": "lightning_bolt",
            "row_content": "<p>✘ Not recommend to use by Children under the age of 9.<\/p><p>✔ Please make sure to wash your mouth with warm water after use.<\/p><p>✔ Includes 1 year manufacturer warranty.<\/p>",
            "page": ""
          }
        },
        "collapsible_row_jVCAfr": {
          "type": "collapsible_row",
          "settings": {
            "heading": "How do I replace the brush head?",
            "icon": "return",
            "row_content": "<p>Your toothbrush includes 3 brush heads to start with, and you can purchase extra replacements anytime. To change a brush head, simply pull off the old one and push the new one on until it clicks securely.<\/p>",
            "page": ""
          }
        },
        "collapsible_row_iBYy4T": {
          "type": "collapsible_row",
          "disabled": true,
          "settings": {
            "heading": "Can the Air Advanced Electric Toothbrush be used on composite bonding, veneers or fillings?",
            "icon": "question_mark",
            "row_content": "<p>Yes, the Air Advanced Electric Toothbrush is suitable for use on composite bonding, veneers, and fillings. It has been designed to be gentle yet effective, ensuring thorough cleaning without causing damage to these dental materials. The advanced bristle technology and multiple brushing modes help maintain oral hygiene and remove plaque, providing a comprehensive clean even with these dental restorations.<\/p>",
            "page": ""
          }
        }
      },
