        "collapsible-row-3": {
          "type": "collapsible_row",
          "settings": {
            "heading": "Features:",
            "icon": "lightning_bolt",
            "row_content": "<p>✓ 5 cleaning modes: White, Clean, Sensitive, Polish, Massage<br\/><br\/> ✓ Sonic power – 40,000 strokes per minute<br\/><br\/> ✓ Smart 2-minute timer with 30-second quad alerts<br\/><br\/> ✓ Long-lasting battery – up to 30 days per charge<br\/><br\/> ✓ W-cut tooth-shaped bristles for thorough cleaning<br\/><br\/> ✓ Quick USB charging for easy top-ups<br\/><br\/> ✓ Uniquely designed W-cut, tooth-shaped bristles for deep cleaning<br\/><br\/> ✓ Replaceable brush heads for consistent hygiene<br\/><br\/> ✓ IPX7 waterproof – safe and travel-ready<br\/><br\/> ✓ Ergonomic, easy-to-hold handle<br\/><br\/> ✓ Sleek, lightweight design for everyday use<\/p>",
            "page": ""
          }
        },
        "collapsible-row-1": {
          "type": "collapsible_row",
          "settings": {
            "heading": "How to use?",
            "icon": "box",
            "row_content": "<p><\/p><p><strong>1. Prep<\/strong>: Wet the bristles and add toothpaste.<br\/><\/p><p><strong>2. Power On<\/strong>: Turn on and select your preferred mode.<br\/><\/p><p><strong>3. Brush Smart<\/strong>: Gently brush while guided by 30-second alerts.<br\/><\/p><p><strong>4. Auto Stop<\/strong>: Shuts off automatically after 2 minutes.<br\/><\/p><p><strong>5. Clean Up<\/strong>: Rinse the head and let it air dry.<\/p>",
            "page": ""
          }
        },
        "2eef6090-250f-48ad-a4ec-4aacca83c975": {
          "type": "collapsible_row",
          "settings": {
            "heading": "Why choose the Sonic 5-in-1?",
            "icon": "clipboard",
            "row_content": "<p>✓ Designed with 5 smart modes for a tailored clean every time<br\/><br\/>✓ Sonic technology reaches where manual brushes can’t<br\/><br\/>✓ Leaves your mouth feeling fresh and cared for<br\/><br\/>✓ Long-lasting battery with convenient USB charging<br\/><br\/>✓ Waterproof, ergonomic, and built for everyday confidence<\/p>",
            "page": ""
          }
        },
        "3442c9b0-dbb6-4dd7-b615-9313ba45f523": {
