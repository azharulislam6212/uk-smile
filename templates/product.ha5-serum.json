    "collapsible-content": {
      "type": "collapsible-content",
      "blocks": {
        "collapsible-row-2": {
          "type": "collapsible_row",
          "settings": {
            "heading": "Benefits of using HA5 Hyaluronic Serum",
            "icon": "heart",
            "row_content": "<p>✓ Hydration: Helps retain moisture in the mouth, supporting daily comfort and freshness<br\/><br\/>✓ Gum Support: Helps maintain hydration levels in the gums to minimise dryness and discomfort<br\/><br\/>✓ Gentle Care: Supports the natural recovery of minor oral irritations caused by brushing or daily habits<br\/><br\/>✓ Comforting Formula: Includes ingredients known for their calming properties<br\/><br\/>✓ Soothing Feel: Provides a refreshing, smooth sensation for your gums<\/p>",
            "page": ""
          }
        },
        "collapsible-row-3": {
          "type": "collapsible_row",
          "settings": {
            "heading": "List of ingredients",
            "icon": "leaf",
            "row_content": "<p>Water\/Aqua, Glycerin, Xylitol, Betaine, Cellulose Gum, Panthenol, Sodium Hyaluronate, Phenoxyethanol,Sucralose, Ethylhexylglycerin,Sodium Phosphate<\/p>",
            "page": ""
          }
        },
        "collapsible-row-1": {
          "type": "collapsible_row",
          "settings": {
            "heading": "Instructions",
            "icon": "question_mark",
            "row_content": "<p>1. Apply 2 pumps to your tongue, either via your finger, toothbrush, or directly on.<\/p><p>2. Use the tip of your tongue to direct the HA5 Serum to your gums<\/p><p>3. Allow the serum to be absorbed by the gums<\/p><p>4. After 1 minute, spit or rinse any excess serum.<\/p>",
            "page": ""
          }
        },
        "dc156c5a-46c9-43e5-acbd-475340353fc0": {
          "type": "collapsible_row",
          "settings": {
            "heading": "When should I use HA5 Serum?",
            "icon": "check_mark",
            "row_content": "<p>HA5 Serum is recommended to be used as a post brushing treatment, however it can also be used on its own.<\/p><p><strong>Recommended usage time<\/strong>: 3 times a week!<\/p>",
            "page": ""
          }
        },
        "collapsible-row-0": {
          "type": "collapsible_row",
          "settings": {
            "heading": "Cautions",
            "icon": "lightning_bolt",
            "row_content": "<p><strong>Storage<\/strong>: Store the product correctly,  typically in a cool, dry place, away from direct sunlight.<\/p><p><strong>Keep out of reach of children<\/strong>: Like all oral care products, HA5 Hyaluronic Serum should be kept out of the reach of children to prevent accidental ingestion.<\/p>",
            "page": ""
          }
        },
        "collapsible_row_Hf9DQ7": {
          "type": "collapsible_row",
          "disabled": true,
          "settings": {
            "heading": "Can the HA5 Hyaluronic Serum be used on composite bonding, veneers or fillings?",
            "icon": "question_mark",
            "row_content": "<p>Yes, the HA5 Hyaluronic Serum is suitable for use on composite bonding, veneers, and fillings. This serum is designed to be gentle on all dental materials while providing deep hydration and care for your gums and oral tissues. It helps to maintain the overall health of your mouth, ensuring that both your natural teeth and dental restorations are well-cared for.<\/p>",
            "page": ""
          }
        }
      },
