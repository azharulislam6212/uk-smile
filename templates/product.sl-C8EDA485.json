    "rich-text-0": {
      "type": "rich-text",
      "blocks": {
        "heading": {
          "type": "heading",
          "settings": {
            "heading": "<p>\"This is the toothbrush of the year. My teeth are clean and I love the smart features. Some times you need more than just brushing your teeth and the smart timer makes sure I do not over or under brush.”<\/p>",
            "heading_size": "h2"
          }
        },
        "text": {
          "type": "text",
          "settings": {
            "text": "<p> Lily J.<\/p>"
          }
        }
      },
      "block_order": [
        "heading",
        "text"
      ],
      "settings": {
        "desktop_content_position": "center",
        "content_alignment": "center",
        "color_scheme": "accent-2",
        "full_width": false,
        "padding_top": 20,
        "padding_bottom": 8
      }
    },
    "collapsible-content": {
      "type": "collapsible-content",
      "blocks": {
        "collapsible-row-3": {
          "type": "collapsible_row",
          "settings": {
            "heading": "Features:",
            "icon": "lightning_bolt",
            "row_content": "<p> ✓ 5 cleaning modes: White, Clean, Sensitive, Polish, Massage<br\/> ✓ Sonic power – 40,000 strokes per minute<br\/> ✓ Smart 2-minute timer with 30-second quad alerts<br\/> ✓ Long-lasting battery – up to 30 days per charge<br\/> ✓ Quick USB charging for easy top-ups<br\/> ✓ Replaceable brush heads for consistent hygiene<br\/> ✓ IPX7 waterproof – safe and travel-ready<br\/> ✓ Ergonomic, easy-to-hold handle<br\/> ✓ Sleek, lightweight design for everyday use<\/p>",
            "page": ""
          }
        },
        "collapsible-row-1": {
          "type": "collapsible_row",
          "settings": {
            "heading": "How to use?",
            "icon": "box",
            "row_content": "<ol><li><strong>Prep<\/strong>: Wet the bristles and add toothpaste.<br\/><\/li><li><strong>Power On<\/strong>: Turn on and select your preferred mode.<br\/><\/li><li><strong>Brush Smart<\/strong>: Gently brush while guided by 30-second alerts.<br\/><\/li><li><strong>Auto Stop<\/strong>: Shuts off automatically after 2 minutes.<br\/><\/li><li><strong>Clean Up<\/strong>: Rinse the head and let it air dry.<\/li><\/ol>",
            "page": ""
          }
        },
        "2eef6090-250f-48ad-a4ec-4aacca83c975": {
          "type": "collapsible_row",
          "settings": {
            "heading": "Why choose the Sonic 5-in-1?",
            "icon": "clipboard",
            "row_content": "<p>✓ Designed with 5 smart modes for a tailored clean every time<br\/> ✓ Sonic technology reaches where manual brushes can’t<br\/> ✓ Leaves your mouth feeling fresh and cared for<br\/> ✓ Long-lasting battery with convenient USB charging<br\/> ✓ Waterproof, ergonomic, and built for everyday confidence<\/p>",
            "page": ""
          }
        },
        "3442c9b0-dbb6-4dd7-b615-9313ba45f523": {
          "type": "collapsible_row",
          "settings": {
            "heading": "What’s in the box?",
            "icon": "question_mark",
            "row_content": "<ul><li>1× Sonic 5-in-1 Electric Toothbrush Handle<br\/><\/li><li>3× Brush Heads<br\/><\/li><li>1× USB Charging Cable<br\/><\/li><li>1× User Manual<\/li><\/ul>",
            "page": ""
          }
        },
        "4629f7ef-2bd9-46e7-a3d7-291adcdb936a": {
          "type": "collapsible_row",
          "settings": {
            "heading": "Suitable For 16+",
            "icon": "check_mark",
            "row_content": "<p>Designed for <strong>ages 16+<\/strong>, making it safe, effective, and reliable for everyday use.<\/p>",
            "page": ""
          }
        },
        "dc156c5a-46c9-43e5-acbd-475340353fc0": {
          "type": "collapsible_row",
          "disabled": true,
          "settings": {
            "heading": "How to use the electric dental cleaning kit?",
            "icon": "washing",
            "row_content": "<p>1. Select your desired attachment based on your oral needs.<\/p><p>2. Turn on the device and alter between modes based on your cleaning needs.<\/p><p>3. Alter between heads if necessary.<\/p><p>4. Clean the device and the tip after use. <\/p>",
            "page": ""
          }
        },
        "b156cbed-7093-4197-84e3-0ced68818bea": {
          "type": "collapsible_row",
          "settings": {
            "heading": "How do I replace the brush head?",
            "icon": "leaf",
            "row_content": "<p>Your toothbrush comes with 3 brush heads included. To replace, simply pull off the old head and push the new one until it clicks securely. Replacements can be purchased anytime.<\/p>",
            "page": ""
          }
        },
        "collapsible-row-0": {
          "type": "collapsible_row",
          "disabled": true,
          "settings": {
            "heading": "Smart 2-Min Timer",
            "icon": "question_mark",
            "row_content": "<p><strong>2-Minute Auto Shutoff<\/strong> ensures proper brushing time<br\/><strong>30-Second Quad Alerts<\/strong> guide kids through all 4 quadrants<\/p>",
            "page": ""
          }
        }
      },
