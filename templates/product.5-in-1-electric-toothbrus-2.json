    "collapsible-content": {
      "type": "collapsible-content",
      "blocks": {
        "collapsible-row-3": {
          "type": "collapsible_row",
          "settings": {
            "heading": "Features:",
            "icon": "lightning_bolt",
            "row_content": "<p>✓ 100% Waterproof - Entire Toothbrush!<\/p><p>✓ Powerful stain removal (includes an enhanced powerful magnetic movement)<\/p><p>✓ 18 unique cleaning modes to choose from<\/p><p>✓ Long lasting battery life<\/p><p>✓ Acoustic Motor<\/p><p><\/p>",
            "page": ""
          }
        },
        "collapsible-row-1": {
          "type": "collapsible_row",
          "settings": {
            "heading": "What's in the box?",
            "icon": "box",
            "row_content": "<p>Each package contains:<\/p><p>1x Electric Toothbrush<\/p><p>4x Additional Heads<\/p><p>1x Charging Cable<\/p><p>1x Manual<\/p>",
            "page": ""
          }
        },
        "2eef6090-250f-48ad-a4ec-4aacca83c975": {
          "type": "collapsible_row",
          "settings": {
            "heading": "Specifications",
            "icon": "clipboard",
            "row_content": "<p><\/p><p>Dimensions: 16.8cm x 2.4cm<\/p><p>18 gears to choose from<\/p><p>IPX7 - 100% waterproof!<\/p><p>180 days standby time<\/p><p><\/p><p><\/p>",
            "page": ""
          }
        },
        "3442c9b0-dbb6-4dd7-b615-9313ba45f523": {
          "type": "collapsible_row",
          "settings": {
            "heading": "Electric Toothbrush vs Manual Toothbrush?",
            "icon": "question_mark",
            "row_content": "<p>Electric toothbrush bristles vibrate or rotate to help you remove plaque buildup from your teeth and gums. The vibration allows for more micro-movements every time you move your toothbrush across your teeth.<\/p><p>This is the main difference between electric and manual toothbrushes. <strong>Manual toothbrushes rely on your ability to effectively brush away plaque and food; electric toothbrushes do the work for you<\/strong>, which has statistically been proven to result in cleaner and whiter teeth.<\/p>",
            "page": ""
          }
        },
        "4629f7ef-2bd9-46e7-a3d7-291adcdb936a": {
          "type": "collapsible_row",
          "settings": {
            "heading": "How do I deep clean the Electric Toothbrush",
            "icon": "check_mark",
            "row_content": "<p>1) Remove the brush head.<\/p><p>2) Rinse the bottom of the brush head with warm water.<\/p><p>3) Rinse the metal shaft area with warm water.<\/p><p>4) Clean the bottom of the toothbrush handle with a damp cotton swab to remove any residue.<\/p><p>5) Wipe the entire surface of the handle with a wet cloth.<\/p>",
            "page": ""
          }
        },
        "dc156c5a-46c9-43e5-acbd-475340353fc0": {
          "type": "collapsible_row",
          "disabled": true,
          "settings": {
            "heading": "How to use the electric dental cleaning kit?",
            "icon": "washing",
            "row_content": "<p>1. Select your desired attachment based on your oral needs.<\/p><p>2. Turn on the device and alter between modes based on your cleaning needs.<\/p><p>3. Alter between heads if necessary.<\/p><p>4. Clean the device and the tip after use. <\/p>",
            "page": ""
          }
        },
        "b156cbed-7093-4197-84e3-0ced68818bea": {
          "type": "collapsible_row",
          "settings": {
            "heading": "Cautions",
            "icon": "leaf",
            "row_content": "<p><\/p><p>Please note this product is suitable for children over 6 years of age.<\/p><p>If you have or had oral or gum surgery in the last 2 months please do not use this product unless approved by your dentist.<\/p><p>If your gums bleed heavily after using the Electric Toothbrush, please discontinue use and consult your dentist. <\/p><p>This product is strictly designed for oral care (cleaning teeth, gums and tongue) please do not use for other purposes. If you feel any discomfort or pain, please consult your dentist.<\/p>",
            "page": ""
          }
        },
        "collapsible-row-0": {
          "type": "collapsible_row",
          "disabled": true,
          "settings": {
            "heading": "Can the Electric Toothbrush be used on composite bonding, veneers or fillings?",
            "icon": "question_mark",
            "row_content": "<p>Yes, the Electric Toothbrush is suitable for use on composite bonding, veneers, and fillings. It has been designed to be gentle yet effective, ensuring thorough cleaning without causing damage to these dental materials. The advanced bristle technology and multiple brushing modes help maintain oral hygiene and remove plaque, providing a comprehensive clean even with these dental restorations.<\/p>",
            "page": ""
          }
        }
      },
