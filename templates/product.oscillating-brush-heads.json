    "rich-text-0": {
      "type": "rich-text",
      "blocks": {
        "heading": {
          "type": "heading",
          "settings": {
            "heading": "<p>LOVE HOW EASY THESE ARE TO SWITCH OUT. THEY LAST LONG, CLEAN DEEPLY, AND NEVER FEEL HARSH. BEEN USING THE SAME BRUSH WITH THESE HEADS FOR MONTHS NOW AND MY DENTIST ACTUALLY NOTICED THE DIFFERENCE.<\/p>",
            "heading_size": "h2"
          }
        },
        "text": {
          "type": "text",
          "settings": {
            "text": "<p>- Anna S.<\/p>"
          }
        }
      },
      "block_order": [
        "heading",
