    "collapsible-content": {
      "type": "collapsible-content",
      "blocks": {
        "collapsible-row-2": {
          "type": "collapsible_row",
          "settings": {
            "heading": "Key Features",
            "icon": "star",
            "row_content": "<ul><li>Dual-action PAP+ whitening and V34 colour correction<\/li><li>Helps reduce yellow tones for brighter-looking teeth<\/li><li>Targets everyday stains from coffee, tea and wine<\/li><li>Peroxide-free formula designed for gentle whitening<\/li><li>Thin strips for a comfortable, secure fit<\/li><li>Easy 30-minute application with no messy trays<\/li><li>Refreshing mint flavour<\/li><li>14 complete whitening treatments included<\/li><\/ul>",
            "page": ""
          }
        },
        "collapsible-row-3": {
          "type": "collapsible_row",
          "settings": {
            "heading": "Ingredients",
            "icon": "leaf",
            "row_content": "<ul><li>Cellulose Gum, Hydroxypropyl Methylcellulose<\/li><li>Phthalimidoperoxycaproic Acid&nbsp;<\/li><li>PVM\/MA Copolymer<\/li><li>&nbsp;Glycerin&nbsp;<\/li><li>Aqua&nbsp;<\/li><li>Xanthan Gum<\/li><li>C12-15 Pareth-3&nbsp;<\/li><li>Menthol&nbsp;<\/li><li>Monosodium Citrate&nbsp;<\/li><li>Disodium EDTA&nbsp;<\/li><li>Sodium Hydroxide&nbsp;<\/li><li>CI 17200,&nbsp;<\/li><li>CI 42090<\/li><\/ul>",
            "page": ""
          }
        },
        "collapsible-row-1": {
          "type": "collapsible_row",
          "settings": {
            "heading": "Instructions",
            "icon": "clipboard",
            "row_content": "<ul><li>Brush and dry your teeth before application.<\/li><li>Carefully peel the strips from the backing film.<\/li><li>Apply one strip to your upper teeth and one to your lower teeth.<\/li><li>Leave the strips on for 30 minutes.<\/li><li>Gently peel off both strips after use.<\/li><li>Rinse your mouth thoroughly with water.<\/li><\/ul>",
            "page": ""
          }
        },
        "collapsible-row-0": {
          "type": "collapsible_row",
          "settings": {
            "heading": "Warnings & Precautions",
            "icon": "lightning_bolt",
            "row_content": "<ul><li>For external use only.<\/li><li>Do not use on broken or sensitive gums.<\/li><li>Avoid contact with eyes. Rinse immediately with water if contact occurs.<\/li><li>Do not swallow the strips.<\/li><li>Do not eat, drink, smoke or sleep while wearing the strips.<\/li><li>Not recommended for pregnant women.<\/li><li>Not suitable for children under 14 years.<\/li><li>Discontinue use if irritation or discomfort occurs.<\/li><li>Keep out of reach of children.<\/li><li>Use only as directed and allow at least 1 month between treatment courses.<\/li><\/ul>",
            "page": ""
          }
        },
        "collapsible_row_iiXMke": {
          "type": "collapsible_row",
          "settings": {
            "heading": "What's in the Box?",
            "icon": "box",
            "row_content": "<ul><li>14 Individual Pouches<\/li><li>28 Whitening Strips (Upper & Lower)<\/li><\/ul>",
            "page": ""
          }
        }
      },
