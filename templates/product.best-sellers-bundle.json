        "collapsible-row-3": {
          "type": "collapsible_row",
          "settings": {
            "heading": "Why Buy The Bundle?",
            "icon": "question_mark",
            "row_content": "<ul><li>Targets multiple layers of buildup<br\/><\/li><li>Water flosser clears debris for smoother cleaning<br\/><\/li><li>Brush boosts results before and after each session<br\/><\/li><li>Better value than buying separately<br\/><\/li><li>Complete at-home oral-care solution<\/li><\/ul>",
            "page": ""
