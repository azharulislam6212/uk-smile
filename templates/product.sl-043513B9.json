    "collapsible-content": {
      "type": "collapsible-content",
      "blocks": {
        "collapsible-row-3": {
          "type": "collapsible_row",
          "settings": {
            "heading": "Benefits & Features",
            "icon": "lightning_bolt",
            "row_content": "<p>✔️ Gentle cleaning that helps reduce buildup and support daily oral care<br\/>✔️ Recommended for children ages 5 years and older<br\/>✔️ Fun and vibrant design that makes kids excited about oral care<br\/>✔️ Multiple nozzles for tailored cleaning that meets every need<br\/>✔️ High-pressure technology designed for hard-to-reach areas, including around braces<br\/>✔️ Supports a consistent care routine while being gentle on soft gums<br\/>✔️ Encourages positive oral hygiene habits<br\/>✔️ Extra-long battery life — over 4 weeks of use on a single charge<br\/>✔️ User-friendly controls for easy operation<br\/>✔️ Portable and convenient for home or travel<br\/>✔️ Boosts confidence with a fresher mouth and brighter-looking smile<br\/>✔️ Gives parents peace of mind with its kid-friendly, effective design (trusted by 20,000+ parents)<\/p>",
            "page": ""
          }
        },
        "collapsible-row-1": {
          "type": "collapsible_row",
          "settings": {
            "heading": "What's in the box?",
            "icon": "box",
            "row_content": "<p>Each package contains:<\/p><p>1x Kids Sonic Water Flosser<\/p><p>4x Nozzle Heads (Cleaning Nozzle, Pressure Nozzle, Orthodontic Nozzle, Tongue Nozzle)<\/p><p>1x USB Charging Cable<\/p><p>1x Manual<\/p><p>1x Smile Therapy Gift Box<\/p>",
            "page": ""
          }
        },
        "2eef6090-250f-48ad-a4ec-4aacca83c975": {
          "type": "collapsible_row",
          "settings": {
            "heading": "Specifications",
            "icon": "clipboard",
            "row_content": "<ul><li>Recommended Age: 5-16 years of age<br\/><\/li><li>Tank Size: 230ML<br\/><\/li><li>Material: BPA-Free Plastic<br\/><\/li><li>100% Waterproof<br\/><\/li><li>Up to 1000 pulses per minute (safe for children)<br\/><\/li><li>3 Modes<br\/><\/li><li>1 year warranty<br\/><\/li><li>Charging time: 4 hours<br\/><\/li><li>Certified<\/li><\/ul>",
            "page": ""
          }
        },
        "4629f7ef-2bd9-46e7-a3d7-291adcdb936a": {
          "type": "collapsible_row",
          "disabled": true,
          "settings": {
            "heading": "How do I deep clean the Electric Toothbrush",
            "icon": "check_mark",
            "row_content": "<p>1) Remove the brush head.<\/p><p>2) Rinse the bottom of the brush head with warm water.<\/p><p>3) Rinse the metal shaft area with warm water.<\/p><p>4) Clean the bottom of the toothbrush handle with a damp cotton swab to remove any residue.<\/p><p>5) Wipe the entire surface of the handle with a wet cloth.<\/p>",
            "page": ""
          }
        },
        "b156cbed-7093-4197-84e3-0ced68818bea": {
          "type": "collapsible_row",
          "settings": {
            "heading": "Cautions",
            "icon": "leaf",
            "row_content": "<p>✘ Not recommended for children aged 4 or younger.<br\/><br\/>✘ Avoid using hot or boiling water in the water reservoir to prevent potential burns or damage to the device.<br\/><br\/>✘ Do not direct the water jet at your eyes or ears to avoid injury or discomfort.<br\/><br\/>✔ Only buy certified Water Flossers.<br\/><br\/>✔ Please make sure to wash your mouth with warm water after use.<\/p>",
            "page": ""
          }
        },
        "collapsible_row_wL8QGg": {
          "type": "collapsible_row",
          "settings": {
            "heading": "Instructions & Tips",
            "icon": "question_mark",
            "row_content": "<p><strong>Charge Your Flosser<\/strong>: Make sure your Water Flosser is fully charged. A quick full charge will last for several weeks!<br\/><\/p><ol><li><strong>Fill the Tank<\/strong>: Add lukewarm water to the 230 ml water tank for a comfortable experience.<br\/><\/li><li><strong>Aim the Tip<\/strong>: Point the 360-degree tip directly into your mouth for effective cleaning.<br\/><\/li><li><strong>Turn It On<\/strong>: Power up your device and choose your preferred mode—there are three options available. We suggest starting with the lowest setting (to begin with).<br\/><\/li><li><strong>Target Those Tough Spots<\/strong>: Focus on hard-to-reach areas to ensure a thorough clean.<\/li><\/ol><p>For best results, we recommend using the Water Flosser before brushing your teeth. This helps remove food particles and debris, making brushing more effective. Getting kids into this habit will significantly improve their oral hygiene<\/p>",
            "page": ""
          }
        }
      },
