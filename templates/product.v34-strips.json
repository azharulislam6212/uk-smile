    "rich-text-0": {
      "type": "rich-text",
      "blocks": {
        "heading": {
          "type": "heading",
          "settings": {
            "heading": "<p>\"Really impressed with these strips! They're so easy to apply, and my smile looked noticeably brighter after using them. Love the fresh mint taste too!\"<\/p>",
            "heading_size": "h2"
          }
        },
        "text": {
          "type": "text",
          "settings": {
            "text": "<p>- Sherrie. L<\/p>"
          }
        }
      },
      "block_order": [
